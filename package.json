        "@vue/tsconfig": "^0.9.0",
        "concurrently": "^10.0.3",
        "eslint": "^9.0.0",
        "eslint-plugin-vue": "^10.0.0",
        "jsdom": "^27.0.0",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.0.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.0.0",
        "typescript-eslint": "^8.0.0",
        "vite": "^8.0.0",
        "vitest": "^4.0.0",
        "vue-tsc": "^3.0.0"
    },
    "dependencies": {
        "@fontsource-variable/bricolage-grotesque": "^5.3.0",
