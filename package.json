{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "dev:all": "concurrently -k --names web,queue,vite --prefix-colors blue,magenta,yellow \"php artisan serve --host=0.0.0.0 --port=8000\" \"php artisan queue:work --sleep=1 --tries=3 --max-time=3600\" \"npm run dev\"",
        "dev:start": "bash .devcontainer/dev.sh start",
        "dev:stop": "bash .devcontainer/dev.sh stop",
        "dev:restart": "bash .devcontainer/dev.sh restart",
        "dev:logs": "bash .devcontainer/dev.sh logs",
        "typecheck": "vue-tsc --noEmit",
        "lint": "eslint resources/js",
        "format": "prettier --write resources/js",
        "format:check": "prettier --check resources/js",
        "test": "vitest run",
        "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^25.0.0",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/test-utils": "^2.4.0",
        "@vue/tsconfig": "^0.9.0",
        "concurrently": "^10.0.3",
        "eslint": "^9.0.0",
        "eslint-plugin-vue": "^10.0.0",
        "jsdom": "^27.0.0",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.0.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.0.0",
        "vite": "^8.0.0",
        "vitest": "^5.0.4",
        "vue-tsc": "^3.0.0"
    },
    "dependencies": {
        "@fontsource-variable/bricolage-grotesque": "^5.3.0",
        "@fontsource-variable/instrument-sans": "^5.3.0",
        "@inertiajs/vue3": "^3.7.1",
        "vue": "^3.5.43"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.5"
    }
}
