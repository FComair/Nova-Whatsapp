{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["vite/client", "node"]
    },
    "include": ["resources/js/**/*.ts", "resources/js/**/*.vue", "vite.config.ts", "vitest.config.ts"]
}
