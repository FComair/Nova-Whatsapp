APP_NAME=Nova
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Langues de l'interface : fr, nl, en (docs/03 §A.5)
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_BE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de données : trois rôles distincts. Valeurs de DEV jetables ; en production, secrets injectés par l'environnement.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nova
DB_USERNAME=nova_app
DB_PASSWORD=nova_app_dev_only
DB_OWNER_USERNAME=nova_owner
DB_OWNER_PASSWORD=nova_dev_only
DB_PLATFORM_USERNAME=nova_platform
DB_PLATFORM_PASSWORD=nova_platform_dev_only

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@nova.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Passerelle WhatsApp (Meta Cloud API) et n8n : valeurs vides ou de dev, jamais de secret reel ici.
WHATSAPP_DRIVER=fake
WHATSAPP_VERIFY_TOKEN=dev-verify-token
WHATSAPP_APP_SECRET=dev-app-secret
N8N_INBOUND_URL=
N8N_SIGNING_SECRET=dev-n8n-secret
NOVA_FOUNDER_EMAIL=
BILLING_GATEWAY=fake
BILLING_SELLER_NAME=
BILLING_SELLER_VAT=
BILLING_SELLER_ADDRESS=
TRUSTED_PROXIES=
NOVA_CSP=report-only
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
NOVA_REQUIRE_2FA=true

# Assistant de conversation WhatsApp : n8n (defaut) ou native. Cle IA optionnelle (menus seuls sans cle).
CONVERSATION_DRIVER=n8n
CONVERSATION_AI_API_KEY=
