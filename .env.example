# =====================================================================================================================
# Nova WhatsApp : variables d'environnement.
#
# Ce fichier est versionné : AUCUN secret réel ici. Les valeurs sont des valeurs de DÉVELOPPEMENT jetables ou des champs vides.
# Copiez-le en .env (jamais versionné) ; dans un Codespace ou un Dev Container, .devcontainer/on-create.sh le fait pour vous.
#
# Chaque variable est précédée de : son rôle · Obligatoire : oui/non · Secret : oui/non.
#   « Obligatoire : oui » = l'application ne démarre pas correctement sans elle (la valeur d'exemple suffit en développement).
#   « Secret : oui »      = en production et dans un test réel, la valeur vient de l'environnement ou des secrets Codespaces
#                           (Settings > Codespaces > Secrets), jamais de ce fichier. Une variable d'environnement prime sur .env.
# =====================================================================================================================

# --- Application -----------------------------------------------------------------------------------------------

# Nom affiché. Obligatoire : oui. Secret : non.
APP_NAME=Nova
# Environnement (local, production). Le jeu de données de démonstration refuse de tourner hors « local ». Obligatoire : oui. Secret : non.
APP_ENV=local
# Clé de chiffrement (chiffre les sessions, notes, jetons). Générée par `php artisan key:generate` (ou .devcontainer/on-create.sh). Obligatoire : oui. Secret : OUI.
APP_KEY=
# Messages d'erreur détaillés : true en développement, JAMAIS en production. Obligatoire : oui. Secret : non.
APP_DEBUG=true
# Adresse publique de l'application (liens des e-mails, cookies). Codespaces : fixée automatiquement à https://<nom>-8000.app.github.dev. Obligatoire : oui. Secret : non.
APP_URL=http://localhost:8000

# Langues de l'interface : fr, nl, en (docs/03 §A.5). Obligatoire : oui. Secret : non.
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
# Langue des données factices (Faker). Obligatoire : non. Secret : non.
APP_FAKER_LOCALE=fr_BE

# Mode maintenance (file | cache). Obligatoire : non. Secret : non.
APP_MAINTENANCE_DRIVER=file
# Coût du hachage des mots de passe. Obligatoire : non. Secret : non.
BCRYPT_ROUNDS=12

# Journaux. Obligatoire : non. Secret : non.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Proxys de confiance (adresses séparées par des virgules, ou *) : IP réelle derrière un proxy. Codespaces : « * » fixé automatiquement. Obligatoire : non en local, OUI en production. Secret : non.
TRUSTED_PROXIES=
# Politique de contenu (report-only | enforce | off). Obligatoire : non. Secret : non.
NOVA_CSP=report-only

# --- Base de données PostgreSQL 16 -----------------------------------------------------------------------------
# Trois rôles distincts (isolation entre clients par RLS : l'application n'utilise JAMAIS le propriétaire). En développement, les rôles
# sont créés par docker/postgres/init/*.sql. En production : secrets injectés par l'environnement.

# Pilote. Obligatoire : oui. Secret : non.
DB_CONNECTION=pgsql
# Hôte et port : « postgres » est le service Docker / Dev Container. Obligatoire : oui. Secret : non.
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nova
# Rôle de l'application (soumis à la RLS). Obligatoire : oui. Secret : OUI en production (valeur jetable en développement).
DB_USERNAME=nova_app
DB_PASSWORD=nova_app_dev_only
# Rôle propriétaire (migrations, tâches d'administration de la base). Obligatoire : oui. Secret : OUI en production.
DB_OWNER_USERNAME=nova_owner
DB_OWNER_PASSWORD=nova_dev_only
# Rôle du Super Admin (lecture plateforme, journalisé à part). Obligatoire : oui. Secret : OUI en production.
DB_PLATFORM_USERNAME=nova_platform
DB_PLATFORM_PASSWORD=nova_platform_dev_only

# --- Sessions, cache, file d'attente (Redis) -------------------------------------------------------------------

# Obligatoire : oui. Secret : non.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie réservé à HTTPS. Codespaces : « true » fixé automatiquement (l'adresse est en https). Obligatoire : non en local, OUI en production. Secret : non.
# SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# File d'attente : traite les messages WhatsApp entrants et les envois (worker : php artisan queue:work). Obligatoire : oui. Secret : non.
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Redis : « redis » est le service Docker / Dev Container. Obligatoire : oui. Secret : mot de passe OUI en production.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- E-mail ---------------------------------------------------------------------------------------------------
# En développement, tous les e-mails arrivent dans Mailpit (interface sur le port 8025) et aucun ne part. Obligatoire : oui. Secret : mot de passe SMTP OUI en production.

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@nova.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Front-end (Vite) ------------------------------------------------------------------------------------------

# Nom exposé au navigateur. Obligatoire : non. Secret : non.
VITE_APP_NAME="${APP_NAME}"
# Adresses de Vite derrière une redirection de ports (Codespaces) ; écrites automatiquement par .devcontainer/post-start.sh. Laisser vide en local.
# Obligatoire : non. Secret : non.
# VITE_DEV_SERVER_ORIGIN=
# VITE_CORS_ORIGIN=
# VITE_HMR_HOST=
# VITE_HMR_PROTOCOL=
# VITE_HMR_CLIENT_PORT=

# --- Accès et sécurité -----------------------------------------------------------------------------------------

# Double authentification obligatoire pour propriétaires et responsables de site. Obligatoire : non (true par défaut ; false en Codespaces pour le développement). Secret : non.
NOVA_REQUIRE_2FA=true
# Double authentification du Super Admin : désactivable UNIQUEMENT en développement local (ignorée ailleurs). Obligatoire : non. Secret : non.
# NOVA_ADMIN_REQUIRE_MFA=true
# Sous-domaine du Super Admin en production (cookies distincts). Vide en développement : le panel est sur /admin. Obligatoire : non. Secret : non.
# NOVA_ADMIN_DOMAIN=admin.example.com
# Envoi du code de vérification téléphonique : « log » en développement (le code est lu dans storage/logs/laravel.log). Obligatoire : non. Secret : non.
# NOVA_PHONE_CODE_DRIVER=log
# Adresse du fondateur pour les alertes techniques ; vide : seul le journal est alerté. Obligatoire : non. Secret : non.
NOVA_FOUNDER_EMAIL=

# --- WhatsApp (Meta Cloud API) et n8n --------------------------------------------------------------------------
# Par défaut, rien n'est envoyé : WHATSAPP_DRIVER=fake enregistre les messages en mémoire. N'activez `meta` qu'avec des identifiants de TEST.

# Pilote d'envoi : fake (développement, aucun appel réseau) | meta. Obligatoire : oui. Secret : non.
WHATSAPP_DRIVER=fake
# Jeton de vérification de l'URL du webhook Meta (choisi par Nova, saisi dans la console Meta). Obligatoire : non (valeur de dev). Secret : OUI.
WHATSAPP_VERIFY_TOKEN=dev-verify-token
# Secret de l'application Meta (signature X-Hub-Signature-256 des webhooks). Obligatoire : non (valeur de dev). Secret : OUI.
WHATSAPP_APP_SECRET=dev-app-secret
# Identifiant PUBLIC de l'application Meta et de la configuration de connexion intégrée ; vides : le bouton « Se connecter avec Meta » n'est pas proposé.
# Obligatoire : non. Secret : non.
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Version et adresse de l'API Graph de Meta. Obligatoire : non. Secret : non.
# WHATSAPP_GRAPH_URL=https://graph.facebook.com
# WHATSAPP_GRAPH_VERSION=v21.0
# Noms des modèles de messages approuvés chez Meta (rappel, confirmation, déplacement, annulation). Obligatoire : non. Secret : non.
# WHATSAPP_TEMPLATE_REMINDER=appointment_reminder
# WHATSAPP_TEMPLATE_CONFIRMATION=appointment_confirmation
# WHATSAPP_TEMPLATE_RESCHEDULED=appointment_rescheduled
# WHATSAPP_TEMPLATE_CANCELLATION=appointment_cancelled
# Modèles du programme de fidélité (catégorie marketing, à faire approuver séparément). Obligatoire : non. Secret : non.
# WHATSAPP_TEMPLATE_LOYALTY_JOINED=loyalty_joined
# WHATSAPP_TEMPLATE_LOYALTY_PROGRESS=loyalty_progress
# WHATSAPP_TEMPLATE_LOYALTY_REWARD=loyalty_reward_earned
# WHATSAPP_TEMPLATE_LOYALTY_REDEEMED=loyalty_reward_redeemed
# WHATSAPP_TEMPLATE_LOYALTY_EXPIRY=loyalty_expiry_reminder
# Adresse du webhook n8n qui reçoit chaque message entrant ; vide : aucun transfert. Obligatoire : non. Secret : non.
N8N_INBOUND_URL=
# Secret de signature partagé avec n8n. Obligatoire : non (valeur de dev). Secret : OUI.
N8N_SIGNING_SECRET=dev-n8n-secret

# --- Assistant de conversation et import de listes de prix (IA) ------------------------------------------------

# Assistant WhatsApp : n8n (défaut) | native. Obligatoire : non. Secret : non.
CONVERSATION_DRIVER=n8n
# Clé API IA (compatible OpenAI). Vide : menus seuls, import de prix indisponible hors mode simulé. Obligatoire : non. Secret : OUI.
CONVERSATION_AI_API_KEY=
# CONVERSATION_AI_BASE_URL=https://api.openai.com/v1
# CONVERSATION_AI_MODEL=gpt-4.1-mini
# Import de liste de prix : openai (lecture par IA, nécessite la clé ci-dessus) | fake (liste d'exemple, développement sans clé). Obligatoire : non. Secret : non.
PRICELIST_DRIVER=openai
# PRICELIST_AI_MODEL=gpt-4.1-mini

# --- Facturation -----------------------------------------------------------------------------------------------

# Prestataire de paiement : fake (aucun débit, développement) | réel (à choisir). Obligatoire : oui. Secret : non.
BILLING_GATEWAY=fake
# Identité légale du vendeur sur les factures et dans les documents juridiques (raison sociale, TVA, adresse). Vide : le nom du service est utilisé.
# Obligatoire : non en développement, OUI en production. Secret : non.
BILLING_SELLER_NAME=
BILLING_SELLER_VAT=
BILLING_SELLER_ADDRESS=

# --- Avis publics sur Nova (facultatif) ------------------------------------------------------------------------

# Adresses https des pages d'avis (Google, Trustpilot) ; vides : le lien correspondant n'est pas affiché. Jamais d'adresse inventée. Obligatoire : non. Secret : non.
NOVA_REVIEW_URL_GOOGLE=
NOVA_REVIEW_URL_TRUSTPILOT=
